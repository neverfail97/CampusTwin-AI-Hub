SUPABASE_URL=https://your-project-ref.supabase.co
# Keep this server-only. Use the Supabase secret key, or legacy service-role key.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-secret
FLASK_SECRET_KEY=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=false

# Optional: CampusTwin works with its local response fallback without an AI key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
